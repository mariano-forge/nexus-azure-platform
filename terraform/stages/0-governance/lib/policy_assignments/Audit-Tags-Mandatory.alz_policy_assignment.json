        "enforcementMode": "Default",
        "nonComplianceMessages": [
            {
                "message": "Resources {enforcementMode} have the required tags."
            }
        ],
        "parameters": {
            "effect": {
                "value": "Audit"
            },
            "mandatoryTags": {
                "value": [
                    "owner",
                    "costcenter"
                ]
            }
        },
        "scope": "/providers/Microsoft.Management/managementGroups/placeholder",
        "notScopes": []
    }
}