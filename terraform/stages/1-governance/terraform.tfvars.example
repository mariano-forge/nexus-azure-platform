# ============================================================
# Stage 1 — Governance
# Copy to terraform.tfvars and fill in your values.
# Run scripts/setup-lib.ps1 (or setup-lib.sh) first with the
# same management_groups_config flags as below.
# ============================================================

# Must match the "name" field in the generated architecture definition JSON.
root_id = "contoso"

# Must match the flags passed to setup-lib.ps1 / setup-lib.sh.
management_groups_config = {
  include_identity       = true
  include_decommissioned = false
  include_local          = false
  include_sandboxes      = true
  include_security       = true
}

default_location = "francecentral"

enable_telemetry = false

# ---------------------------------------------------------------------------
# Subscription placement — map subscriptions to management groups.
# ---------------------------------------------------------------------------
subscription_placement = {
  # "my-corp-prod" = {
  #   subscription_id       = "00000000-0000-0000-0000-000000000001"
  #   management_group_name = "contoso-corp"
  # }
  # "my-online-prod" = {
  #   subscription_id       = "00000000-0000-0000-0000-000000000002"
  #   management_group_name = "contoso-online"
  # }
}

# ---------------------------------------------------------------------------
# Policy default values — required by some ALZ built-in policies.
# ---------------------------------------------------------------------------
policy_default_values = {
  # "emailSecurityContact" = jsonencode({ value = "security@contoso.com" })
  # "logAnalyticsWorkspaceId" = jsonencode({ value = "/subscriptions/.../workspaces/my-law" })
}

# ---------------------------------------------------------------------------
# Management group role assignments.
# ---------------------------------------------------------------------------
management_group_role_assignments = {}